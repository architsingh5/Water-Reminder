<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#CFFAFE</color>

    <!-- "Aqua Day" widget palette; the night folder holds the OLED variant. -->
    <color name="widget_background">#FFFFFF</color>
    <color name="widget_text_primary">#0F1B1E</color>
    <color name="widget_text_secondary">#4B6168</color>
    <color name="widget_accent">#0A7C8E</color>
    <color name="widget_on_accent">#FFFFFF</color>
    <color name="widget_progress_track">#CCF3F8</color>

    <!-- Material You variant; overridden in values-v31. Below Android 12 these
         simply mirror the brand palette so the dynamic layout still renders. -->
    <color name="widget_dyn_background">@color/widget_background</color>
    <color name="widget_dyn_text_primary">@color/widget_text_primary</color>
    <color name="widget_dyn_text_secondary">@color/widget_text_secondary</color>
    <color name="widget_dyn_accent">@color/widget_accent</color>
    <color name="widget_dyn_on_accent">@color/widget_on_accent</color>
    <color name="widget_dyn_progress_track">@color/widget_progress_track</color>
</resources>
